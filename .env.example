# Discord bot token from the Developer Portal. Never commit your real token.
DISCORD_TOKEN="YOUR_BOT_TOKEN"

# Application ID from the General Information page.
DISCORD_CLIENT_ID="YOUR_APPLICATION_ID"

# Optional test server ID. Keep it for fast guild command deployment.
# Remove this variable when you intentionally want global command deployment.
DISCORD_GUILD_ID="YOUR_TEST_GUILD_ID"

# Prisma SQLite URL. Relative file paths are resolved from prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Consecutive crashes allowed before a non-system app is disabled automatically.
APP_CRASH_THRESHOLD="3"

# When true, ServerOS loads only the app IDs listed in SERVEROS_SAFE_APPS.
SERVEROS_SAFE_MODE="false"

# Comma-separated recovery app IDs that remain available in Safe Mode.
SERVEROS_SAFE_APPS="terminal"
